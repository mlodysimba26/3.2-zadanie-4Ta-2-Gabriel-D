<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="600"
        Width="700" Height="620"
        x:Class="notatnik.MainWindow"
        Title="Notatnik — Zadanie 3.2">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <!-- Formularz dodawania notatki -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Tytuł notatki:" FontWeight="Bold" />
            <TextBox Name="TitleBox" PlaceholderText="Wpisz tytuł..." />
            
            <TextBlock Text="Treść notatki:" FontWeight="Bold" />
            <TextBox Name="ContentBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Wpisz treść notatki..." />
            
            <Button Name="SaveButton" Content="Zapisz notatkę" Click="SaveButton_Click" HorizontalAlignment="Left" Margin="0,4,0,4" />
            <TextBlock Name="StatusText" Margin="0,0,0,10" Foreground="DimGray" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Lista zapisanych notatek -->
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="Zapisane notatki (z pliku notatki.md):" FontWeight="Bold" Margin="0,0,0,6" />
            <ListBox Name="NotesListBox" />
        </DockPanel>
    </Grid>
</Window>
